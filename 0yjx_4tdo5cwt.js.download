    query DeploymentSeoScore($replId: String!) {
  getRepl(id: $replId) {
    ... on Repl {
      __typename
      id
      hostingDeployment {
        ... on HostingDeployment {
          __typename
          id
          currentBuild {
            __typename
            id
            status
            latestSeoScore
            latestLighthouseRun {
              __typename
              id
              url
              seoScore
              seoActionItems
            }
          }
        }
        ... on Error {
          message
        }
      }
    }
    ... on Error {
      message
    }
