<html>
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:">
<style>
  *, *::before, *::after { box-sizing: border-box; }
  body {
    margin: 0 auto;
    padding: 24px;
    max-width: 816px;
    font-size: 12pt;
    line-height: 1.6;
    font-family: 'Times New Roman', Times, serif;
    color: ${b.defaultTextColor1500};
    background: ${b.defaultSurfaceColor200};
  }
  h1 { margin-top: 1em; margin-bottom: 0.5em; font-size: 24pt; }
  h2 { margin-top: 1em; margin-bottom: 0.33em; font-size: 18pt; }
  h3 { margin-top: 1em; margin-bottom: 0.43em; font-size: 14pt; }
  h4, h5, h6 { margin-top: 1em; margin-bottom: 0.5em; font-size: 12pt; }
  p { margin-bottom: 12pt; }
  ul, ol { margin-bottom: 12pt; padding-left: 0.5in; }
  li { margin-bottom: 6pt; }
  table { margin-bottom: 12pt; border-collapse: collapse; width: 100%; }
  th, td { border: 1px solid ${b.defaultSurfaceColor600}; padding: 6pt 8pt; text-align: left; }
  th { background: ${b.defaultSurfaceColor400}; font-weight: bold; }
  img { max-width: 100%; height: auto; }
  a { color: ${b.primarySurfaceColor100}; text-decoration: underline; }
  ::selection { background: ${b.primarySurfaceColor100}33; }
${r?"html, body { overflow: hidden; }":""}</style>
